{
  "name": "@wts/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "tailwindcss -i ./src/app/globals.css -o ./src/app/tailwind-compiled.css --minify",
    "build": "tailwindcss -i ./src/app/globals.css -o ./src/app/tailwind-compiled.css --minify && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@vercel/speed-insights": "^2.0.0",
    "@wts/analyzers": "*",
    "@wts/dsl": "*",
    "@wts/nlp": "*",
    "@wts/ownership": "*",
    "@wts/policy": "*",
    "@wts/runner": "*",
    "autoprefixer": "^10.5.5",
    "firebase": "^12.18.0",
    "lucide-react": "^1.34.0",
    "next": "^15.5.0",
    "playwright-core": "1.52.0",
    "postcss": "^8.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@playwright/test": "1.52.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.2"
  }
