# ─────────────────────────────────────────────────────────────────────
# Webtest Scanner — Environment Variables
# Copy this file to .env.local and fill in the values you need.
# ─────────────────────────────────────────────────────────────────────

# ── Remote Browser  (Tier 0 — highest priority) ───────────────────────
#
# Connect to any remote browser over WebSocket for maximum stealth.
# The runner tries Playwright server protocol first, then raw CDP —
# so one env var works across all providers listed below.
#
# ── FREE / OPEN SOURCE OPTIONS ────────────────────────────────────────
#
# Option A: Playwright's built-in server (zero cost, zero infra)
#   Start locally: npx playwright run-server --port 9222
#   On a free VPS : same command, keep running with pm2 or screen
#   Free VPS options: Oracle Cloud Free Tier, Google Cloud e2-micro
#   REMOTE_BROWSER_WS_ENDPOINT=ws://YOUR_VPS_IP:9222
#
# Option B: browserless (open source, self-hostable with Docker)
#   Docker: docker run -p 3000:3000 ghcr.io/browserless/chromium
#   Free cloud: https://browserless.io (6 hours/month free)
#   Deploy free: Railway, Render, Fly.io (all have free tiers)
#   REMOTE_BROWSER_WS_ENDPOINT=ws://localhost:3000
#
# Option C: Steel browser (open source, free cloud tier)
#   Repo   : https://github.com/steel-dev/steel-browser
#   Docker : docker run -p 3000:3000 ghcr.io/steel-dev/steel-browser
#   Cloud  : https://app.steel.dev (free tier available)
#   REMOTE_BROWSER_WS_ENDPOINT=ws://localhost:3000
#
# Option D: Plain Chromium with remote debugging (zero cost)
#   Start: chromium --remote-debugging-port=9222 --headless --no-sandbox
#   REMOTE_BROWSER_WS_ENDPOINT=http://localhost:9222
#
# ── PAID OPTIONS ──────────────────────────────────────────────────────
#
# Bright Data Scraping Browser (~$50/mo, real Chrome + auto-CAPTCHA solve)
#   https://brightdata.com → Proxies & Scraping → Scraping Browser
#   Format: wss://brd-customer-XXXXX:PASSWORD@brd.superproxy.io:9222
#   Note: you can also use the legacy BRIGHT_DATA_WS_ENDPOINT alias below.
#
# ──────────────────────────────────────────────────────────────────────
REMOTE_BROWSER_WS_ENDPOINT=

# Legacy alias — kept for backward compatibility, same as above
# BRIGHT_DATA_WS_ENDPOINT=

# ── Optional proxy for local stealth tiers (Tier 1 & 2) ──────────────
# Not needed when using a remote browser endpoint (it handles routing).
# Supports HTTP, HTTPS, SOCKS5.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
